# User-provided OpenAI-compatible LLM API (never commit your actual .env)
LLM_API_KEY=replace-with-your-own-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=tool-calling-model-id

# Market data: default synthetic demo; live is optional and read-only
FIN_GUARD_DATA_MODE=demo
FIN_GUARD_DEMO_SCENARIO=SCENARIO_T0
FIN_GUARD_DEMO_T1_SCENARIO=SCENARIO_T1
FIN_GUARD_DB_PATH=finguard.sqlite3
FIN_GUARD_MAX_STEPS=12
FIN_GUARD_MAX_TOOL_CALLS=40
FIN_GUARD_MODEL_TIMEOUT=60
FIN_GUARD_TOOL_TIMEOUT=20
FIN_GUARD_LEASE_TTL=60
# FIN_GUARD_MARKET_API_KEY=replace-if-live-provider-requires-one
